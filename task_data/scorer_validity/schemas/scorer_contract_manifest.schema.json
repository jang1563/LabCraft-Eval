{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jang1563/LabCraft-Eval/task_data/scorer_validity/schemas/scorer_contract_manifest.schema.json",
  "title": "LabCraft-Eval P1 scorer contract manifest",
  "type": "object",
  "required": [
    "contract_schema_version",
    "contract_set",
    "contract_set_version",
    "status",
    "review_status",
    "promotion_eligible",
    "component_weights",
    "required_fixture_families",
    "schema_paths",
    "review_manifest_path",
    "tasks"
  ],
  "properties": {
    "contract_schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "contract_set": {"const": "p1_wet_lab"},
    "contract_set_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "development_scorer_conformance"},
    "review_status": {"enum": ["pending_expert_review", "expert_approved"]},
    "promotion_eligible": {"type": "boolean"},
    "component_weights": {
      "type": "object",
      "required": ["task_success", "decision_quality", "troubleshooting", "efficiency"],
      "additionalProperties": false,
      "properties": {
        "task_success": {"type": "number", "minimum": 0, "maximum": 1},
        "decision_quality": {"type": "number", "minimum": 0, "maximum": 1},
        "troubleshooting": {"type": "number", "minimum": 0, "maximum": 1},
        "efficiency": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "required_fixture_families": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "canonical_valid",
          "alternative_valid",
          "forged",
          "partial",
          "orphan",
          "contradictory",
          "retry"
        ]
      }
    },
    "schema_paths": {"type": "object"},
    "review_manifest_path": {"type": "string"},
    "tasks": {
      "type": "object",
      "required": [
        "golden_gate_01",
        "gibson_01",
        "miniprep_01",
        "express_01",
        "purify_01"
      ],
      "additionalProperties": false,
      "properties": {
        "golden_gate_01": {"$ref": "#/$defs/taskContract"},
        "gibson_01": {"$ref": "#/$defs/taskContract"},
        "miniprep_01": {"$ref": "#/$defs/taskContract"},
        "express_01": {"$ref": "#/$defs/taskContract"},
        "purify_01": {"$ref": "#/$defs/taskContract"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "taskContract": {
      "type": "object",
      "required": [
        "scorer_version",
        "scorer_callable",
        "inspect_builder",
        "scorer_source_path",
        "scorer_source_sha256",
        "ground_truth_path",
        "ground_truth_sha256",
        "rubric_path",
        "rubric_sha256",
        "fixture_path",
        "fixture_sha256",
        "fixture_count",
        "report_field_count",
        "report_fields",
        "decision_point_ids",
        "evidence_policy"
      ],
      "properties": {
        "scorer_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "scorer_callable": {"type": "string"},
        "inspect_builder": {"type": "string"},
        "scorer_source_path": {"type": "string"},
        "scorer_source_sha256": {"$ref": "#/$defs/sha256"},
        "ground_truth_path": {"type": "string"},
        "ground_truth_sha256": {"$ref": "#/$defs/sha256"},
        "rubric_path": {"type": "string"},
        "rubric_sha256": {"$ref": "#/$defs/sha256"},
        "fixture_path": {"type": "string"},
        "fixture_sha256": {"$ref": "#/$defs/sha256"},
        "fixture_count": {"const": 7},
        "report_field_count": {"type": "integer", "minimum": 1},
        "report_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "decision_point_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_policy": {
          "type": "object",
          "required": [
            "request_and_output_required",
            "output_authoritative",
            "causal_order_required",
            "attempt_policy",
            "retry_semantics"
          ],
          "properties": {
            "request_and_output_required": {"const": true},
            "output_authoritative": {"const": true},
            "causal_order_required": {"const": true},
            "attempt_policy": {"enum": ["linked_success_path", "exactly_one_experimental_call"]},
            "retry_semantics": {"type": "string"}
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
