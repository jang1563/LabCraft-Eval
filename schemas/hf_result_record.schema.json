{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jang1563/LabCraft-Eval/schemas/hf_result_record.schema.json",
  "title": "LabCraft-Eval Hugging Face result record",
  "type": "object",
  "required": [
    "schema_version",
    "source_commit",
    "evaluation_revision",
    "model_generate_config",
    "model",
    "task",
    "track",
    "sample_id",
    "eval_log",
    "eval_log_path",
    "status",
    "created",
    "tokens",
    "scores"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "source_commit": {
      "type": "string"
    },
    "evaluation_revision": {
      "type": "object",
      "required": ["type", "origin", "commit", "dirty"],
      "properties": {
        "type": {"type": "string"},
        "origin": {"type": "string"},
        "commit": {"type": "string", "minLength": 1},
        "dirty": {"const": false}
      },
      "additionalProperties": true
    },
    "model_generate_config": {
      "type": "object",
      "minProperties": 1
    },
    "model": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "track": {
      "type": "string"
    },
    "sample_id": {
      "type": "string"
    },
    "eval_log": {
      "type": "string"
    },
    "status": {
      "const": "success"
    },
    "created": {
      "type": "string"
    },
    "eval_log_path": {
      "type": "string"
    },
    "tokens": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "scores": {
      "type": "object",
      "required": ["overall"],
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    }
  },
  "additionalProperties": true
}
