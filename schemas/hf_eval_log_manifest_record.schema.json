{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jang1563/LabCraft-Eval/schemas/hf_eval_log_manifest_record.schema.json",
  "title": "LabCraft-Eval Hugging Face eval-log manifest record",
  "type": "object",
  "required": [
    "schema_version",
    "source_commit",
    "path",
    "source_path",
    "log_dir",
    "filename",
    "sha256",
    "bytes",
    "status",
    "evaluation_revision",
    "model_generate_config",
    "sample_count"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "source_commit": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "source_path": {"type": "string", "minLength": 1},
    "log_dir": {"type": "string", "minLength": 1},
    "filename": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bytes": {"type": "integer", "minimum": 1},
    "status": {"const": "success"},
    "evaluation_revision": {
      "type": "object",
      "required": ["type", "origin", "commit", "dirty"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "origin": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1},
        "dirty": {"const": false}
      },
      "additionalProperties": true
    },
    "model_generate_config": {"type": "object", "minProperties": 1},
    "sample_count": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
